# ==============================================================================
# Backend Local Environment Configuration Template
# ==============================================================================
# For local zero-setup development, copy to 'backend/.env':
#   cp backend/.env.example backend/.env
# ==============================================================================

ENVIRONMENT=development

# Optional: set for local PostgreSQL; if omitted, defaults to SQLite local database
# DATABASE_URL=postgresql://user:password@localhost:5432/pipeline_db

# Google Gemini AI Key (Required for AI diagnostic reports)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token (Optional: for private repos & higher rate limits)
GITHUB_TOKEN=

# GitHub Webhook Secret (HMAC-SHA256 signature verification)
WEBHOOK_SECRET=

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:5173
