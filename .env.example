# ==============================================================================
# Pipeline Failure Detection 3.0 - Production Environment Secrets Template
# ==============================================================================
# Copy this file to '.env' before running Docker Compose or deploying to production:
#   cp .env.example .env
#
# Generate secure random passwords (e.g., in PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Or on Unix: openssl rand -hex 24
# ==============================================================================

# Application Environment: 'production' or 'development'
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 1. PostgreSQL Production Database Credentials (REQUIRED for Docker / Production)
# ------------------------------------------------------------------------------
POSTGRES_USER=pipeline_admin
POSTGRES_PASSWORD=replace_with_strong_random_password_min_24_chars
POSTGRES_DB=pipeline_db
POSTGRES_PORT=5432

# Optional explicit connection string override:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 2. Redis Message Broker & Celery Queue
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
TASK_QUEUE_MODE=celery

# ------------------------------------------------------------------------------
# 3. Security, Webhooks & GitHub Integration
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (for higher rate limits & private repositories)
GITHUB_TOKEN=

# GitHub Webhook Secret (used for HMAC-SHA256 signature verification)
WEBHOOK_SECRET=

# Allowed CORS Origins (comma-separated list of authorized domains)
ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Engine
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
