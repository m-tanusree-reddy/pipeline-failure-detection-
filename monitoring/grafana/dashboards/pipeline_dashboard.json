  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total CI Failures Ingested",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(pipeline_failures_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Recurrent Failure Events",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(pipeline_recurrence_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "orange", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Remediations Approved",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(pipeline_remediations_total{status='approved'})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Active Worker Queue Tasks",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(pipeline_queue_depth)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Pipeline Failures by Category",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (failure_type) (rate(pipeline_failures_total[5m]))",
          "legendFormat": "{{failure_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Notifications Dispatched by Channel",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (channel) (pipeline_notifications_sent_total)",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ]
    }
  ],
